{
  "name": "@oberyn/sdk",
  "version": "0.1.0",
  "description": "Oberyn error monitoring SDK for TypeScript",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/integrations/browser.d.ts",
      "import": "./dist/integrations/browser.js",
      "require": "./dist/integrations/browser.cjs"
    },
    "./react": {
      "types": "./dist/integrations/react.d.ts",
      "import": "./dist/integrations/react.js",
      "require": "./dist/integrations/react.cjs"
    },
    "./next": {
      "types": "./dist/integrations/next.d.ts",
      "import": "./dist/integrations/next.js",
      "require": "./dist/integrations/next.cjs"
    },
    "./express": {
      "types": "./dist/integrations/express.d.ts",
      "import": "./dist/integrations/express.js",
      "require": "./dist/integrations/express.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/check-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "eslint": "^9",
    "tsup": "^8",
    "typescript-eslint": "^8",
    "vitest": "^3"
  },
  "dependencies": {}
}

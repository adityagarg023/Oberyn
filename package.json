{
  "name": "oberyn",
  "version": "0.1.0",
  "private": true,
  "description": "Oberyn: multi-tenant error monitoring platform",
  "license": "MIT",
  "workspaces": [
    "apps/dashboard",
    "apps/demo",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @oberyn/dashboard",
    "dev:demo": "npm run dev -w @oberyn/demo",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^20",
    "prettier": "^3.6.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}

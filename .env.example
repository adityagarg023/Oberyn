# Copy to .env and replace the placeholder values. Never commit .env.

# Runtime (apps/api and apps/workers)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local infrastructure (infra/docker-compose.yml)
POSTGRES_USER=oberyn
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=oberyn
POSTGRES_PORT=5432
REDIS_PORT=6379

# Connection strings consumed by the API and workers once persistence is wired up
DATABASE_URL=postgresql://oberyn:change-me-local-only@localhost:5432/oberyn
REDIS_URL=redis://localhost:6379/0
EVENT_STREAM_NAME=events.raw
EVENT_CONSUMER_GROUP=oberyn-workers
EVENT_READ_COUNT=25
EVENT_BLOCK_MS=1000
EVENT_CLAIM_IDLE_MS=60000
# Optional: set a stable unique name per worker process
# EVENT_CONSUMER_NAME=worker-local-1

# Event contract v1 hard limits (API)
EVENT_MAX_PAYLOAD_BYTES=204800
EVENT_MAX_STACK_DEPTH=50
EVENT_MAX_BREADCRUMBS=100
EVENT_MAX_STRING_LENGTH=4096

# Dashboard and Clerk auth
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-clerk-domain
OBERYN_INGEST_URL=http://localhost:8000
DASHBOARD_ORIGINS=http://localhost:3000

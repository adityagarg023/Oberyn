# Copy to .env and replace the placeholder values. Never commit .env.

# Runtime (apps/api and apps/workers)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local infrastructure (infra/docker-compose.yml)
POSTGRES_USER=oberyn
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=oberyn
POSTGRES_PORT=5432
REDIS_PORT=6379

# Connection strings consumed by the API and workers once persistence is wired up
DATABASE_URL=postgresql://oberyn:change-me-local-only@localhost:5432/oberyn
REDIS_URL=redis://localhost:6379/0

# Event contract v1 hard limits (API)
EVENT_MAX_PAYLOAD_BYTES=204800
EVENT_MAX_STACK_DEPTH=50
EVENT_MAX_BREADCRUMBS=100
EVENT_MAX_STRING_LENGTH=4096

# Dashboard (apps/dashboard)
NEXT_PUBLIC_API_URL=http://localhost:8000
